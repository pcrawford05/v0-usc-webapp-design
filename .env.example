# Free-tier AI for the "Ask AI" tab. Set at least one; Gemini is tried first, Groq second.
# Without either, Ask AI still works using keyword matching.

# Google AI Studio key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-lite-latest (largest free daily quota).
GEMINI_MODEL=

# Groq key (free): https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
